# Maintainer: Ashfaq Khan Rafin <ashfaqrafin12345@gmail.com>
pkgname=git-graft-git
pkgver=0.1.0
pkgrel=1
pkgdesc='See what git does: animated commit graphs in your terminal (latest from git)'
arch=('x86_64' 'aarch64')
url='https://github.com/ashfaqrafin/graft'
license=('MIT')
depends=('git' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')
provides=('git-graft')
conflicts=('git-graft')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  local bin=target/release/git-graft
  "$bin" completions bash > git-graft.bash
  "$bin" completions zsh > _git-graft
  "$bin" completions fish > git-graft.fish
  "$bin" man > git-graft.1
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/git-graft "$pkgdir/usr/bin/git-graft"
  install -Dm644 git-graft.bash "$pkgdir/usr/share/bash-completion/completions/git-graft"
  install -Dm644 _git-graft "$pkgdir/usr/share/zsh/site-functions/_git-graft"
  install -Dm644 git-graft.fish "$pkgdir/usr/share/fish/vendor_completions.d/git-graft.fish"
  install -Dm644 git-graft.1 "$pkgdir/usr/share/man/man1/git-graft.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
