# Maintainer: Ashfaq Khan Rafin <ashfaqrafin12345@gmail.com>
#
# After tagging a release: bump pkgver, run `updpkgsums`, then
# `makepkg --printsrcinfo > .SRCINFO` and push to aur.archlinux.org/git-graft.git.
pkgname=git-graft
pkgver=0.1.0
pkgrel=1
pkgdesc='See what git does: animated commit graphs in your terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/ashfaqrafin/graft'
license=('MIT')
depends=('git' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b393e6ce6443f79c09d90bd2cd8576146082c705862b19e51a0f97a2acec47f9')

prepare() {
  cd "graft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "graft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  local bin=target/release/git-graft
  "$bin" completions bash > git-graft.bash
  "$bin" completions zsh > _git-graft
  "$bin" completions fish > git-graft.fish
  "$bin" man > git-graft.1
}

check() {
  cd "graft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "graft-$pkgver"
  install -Dm755 target/release/git-graft "$pkgdir/usr/bin/git-graft"
  install -Dm644 git-graft.bash "$pkgdir/usr/share/bash-completion/completions/git-graft"
  install -Dm644 _git-graft "$pkgdir/usr/share/zsh/site-functions/_git-graft"
  install -Dm644 git-graft.fish "$pkgdir/usr/share/fish/vendor_completions.d/git-graft.fish"
  install -Dm644 git-graft.1 "$pkgdir/usr/share/man/man1/git-graft.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
