# Maintainer: Ashfaq Khan Rafin <ashfaqrafin12345@gmail.com>
pkgname=graft-git
pkgver=0.1.0
pkgrel=1
pkgdesc='See what git does: animated commit graphs in your terminal (latest from git)'
arch=('x86_64' 'aarch64')
url='https://github.com/ashfaqrafin/graft'
license=('MIT')
depends=('git' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')
provides=('graft')
conflicts=('graft')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  local bin=target/release/graft
  "$bin" completions bash > graft.bash
  "$bin" completions zsh > _graft
  "$bin" completions fish > graft.fish
  "$bin" man > graft.1
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/graft "$pkgdir/usr/bin/graft"
  install -Dm644 graft.bash "$pkgdir/usr/share/bash-completion/completions/graft"
  install -Dm644 _graft "$pkgdir/usr/share/zsh/site-functions/_graft"
  install -Dm644 graft.fish "$pkgdir/usr/share/fish/vendor_completions.d/graft.fish"
  install -Dm644 graft.1 "$pkgdir/usr/share/man/man1/graft.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/graft/LICENSE"
}
