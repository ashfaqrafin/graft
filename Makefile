# Build and install graft from source.
#
#   make                         build
#   sudo make install            install to /usr/local
#   make install PREFIX=~/.local install for your user only
#   make uninstall               remove what `make install` added

PREFIX  ?= /usr/local
DESTDIR ?=
CARGO   ?= cargo
BIN     := target/release/graft

BINDIR  := $(DESTDIR)$(PREFIX)/bin
MANDIR  := $(DESTDIR)$(PREFIX)/share/man/man1
BASHDIR := $(DESTDIR)$(PREFIX)/share/bash-completion/completions
ZSHDIR  := $(DESTDIR)$(PREFIX)/share/zsh/site-functions
FISHDIR := $(DESTDIR)$(PREFIX)/share/fish/vendor_completions.d

.PHONY: all build extras install uninstall test clean

all: build

build:
	$(CARGO) build --release --locked

# Completions and the man page, generated by the binary itself.
extras: build
	mkdir -p target/completions target/man
	$(BIN) completions bash > target/completions/graft.bash
	$(BIN) completions zsh  > target/completions/_graft
	$(BIN) completions fish > target/completions/graft.fish
	$(BIN) man > target/man/graft.1

install: extras
	install -Dm755 $(BIN) $(BINDIR)/graft
	install -Dm644 target/man/graft.1 $(MANDIR)/graft.1
	install -Dm644 target/completions/graft.bash $(BASHDIR)/graft
	install -Dm644 target/completions/_graft $(ZSHDIR)/_graft
	install -Dm644 target/completions/graft.fish $(FISHDIR)/graft.fish
	@echo
	@echo "installed graft to $(BINDIR)/graft"
	@echo "run 'graft setup' to make plain git commands animate"

uninstall:
	rm -f $(BINDIR)/graft $(MANDIR)/graft.1 $(BASHDIR)/graft $(ZSHDIR)/_graft $(FISHDIR)/graft.fish

test:
	$(CARGO) test --locked

clean:
	$(CARGO) clean
