# Build and install git-graft from source.
#
#   make                         build
#   sudo make install            install to /usr/local
#   make install PREFIX=~/.local install for your user only
#   make uninstall               remove what `make install` added

PREFIX  ?= /usr/local
DESTDIR ?=
CARGO   ?= cargo
BIN     := target/release/git-graft

BINDIR  := $(DESTDIR)$(PREFIX)/bin
MANDIR  := $(DESTDIR)$(PREFIX)/share/man/man1
BASHDIR := $(DESTDIR)$(PREFIX)/share/bash-completion/completions
ZSHDIR  := $(DESTDIR)$(PREFIX)/share/zsh/site-functions
FISHDIR := $(DESTDIR)$(PREFIX)/share/fish/vendor_completions.d

.PHONY: all build extras install uninstall test clean

all: build

build:
	$(CARGO) build --release --locked

# Completions and the man page, generated by the binary itself.
extras: build
	mkdir -p target/completions target/man
	$(BIN) completions bash > target/completions/git-graft.bash
	$(BIN) completions zsh  > target/completions/_git-graft
	$(BIN) completions fish > target/completions/git-graft.fish
	$(BIN) man > target/man/git-graft.1

install: extras
	install -Dm755 $(BIN) $(BINDIR)/git-graft
	install -Dm644 target/man/git-graft.1 $(MANDIR)/git-graft.1
	install -Dm644 target/completions/git-graft.bash $(BASHDIR)/git-graft
	install -Dm644 target/completions/_git-graft $(ZSHDIR)/_git-graft
	install -Dm644 target/completions/git-graft.fish $(FISHDIR)/git-graft.fish
	@echo
	@echo "installed graft to $(BINDIR)/git-graft"
	@echo "run 'git graft setup' to make plain git commands animate"

uninstall:
	rm -f $(BINDIR)/git-graft $(MANDIR)/git-graft.1 $(BASHDIR)/git-graft $(ZSHDIR)/_git-graft $(FISHDIR)/git-graft.fish

test:
	$(CARGO) test --locked

clean:
	$(CARGO) clean
